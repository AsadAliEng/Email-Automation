{
  "name": "Task 2 - Short Feasible Email Automation",
  "active": false,
  "settings": {"executionOrder": "v1"},
  "nodes": [
    {"parameters": {}, "id": "start", "name": "Manual Start", "type": "n8n-nodes-base.manualTrigger", "typeVersion": 1, "position": [0, 0]},
    {"parameters": {"operation": "read", "documentId": "GOOGLE_SHEET_ID", "sheetName": "Config", "options": {}}, "id": "config", "name": "Read Config", "type": "n8n-nodes-base.googleSheets", "typeVersion": 4, "position": [220, 0], "credentials": {"googleSheetsOAuth2Api": {"name": "Google Sheets account"}}, "retryOnFail": true, "maxTries": 3, "waitBetweenTries": 2000},
    {"parameters": {"mode": "runOnceForAllItems", "jsCode": "const config = Object.fromEntries($input.all().map(item => [item.json.Key, item.json.Value]));\nif (String(config.control_mode || 'Run').toLowerCase() === 'pause') return [];\nreturn [{ json: { ...config, max_attempts: Number(config.max_attempts || 3) } }];"}, "id": "gate", "name": "Run Gate", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [440, 0]},
    {"parameters": {"operation": "read", "documentId": "GOOGLE_SHEET_ID", "sheetName": "Sources", "options": {}}, "id": "sources", "name": "Read Sources", "type": "n8n-nodes-base.googleSheets", "typeVersion": 4, "position": [660, 0], "credentials": {"googleSheetsOAuth2Api": {"name": "Google Sheets account"}}, "retryOnFail": true, "maxTries": 3, "waitBetweenTries": 2000},
    {"parameters": {"url": "={{$json.Source_URL}}", "options": {"timeout": 15000, "response": {"response": {"responseFormat": "text"}}}}, "id": "fetch", "name": "HTTP Fetch Pages", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [880, 0], "retryOnFail": true, "maxTries": 3, "waitBetweenTries": 2000},
    {"parameters": {"mode": "runOnceForAllItems", "jsCode": "const re = /[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}/gi;\nconst found = new Map();\nfor (const item of $input.all()) {\n  const text = String(item.json.body ?? item.json.data ?? item.json);\n  for (const value of text.match(re) || []) {\n    const email = value.toLowerCase();\n    if (!found.has(email)) found.set(email, { Contact_Email: email, Source_URL: item.json.Source_URL || '', Status: 'New', Sequence: 0, Reply_Detected: 'false', Unsubscribe_Detected: 'false', Attempts: 0 });\n  }\n}\nreturn [...found.values()].map(json => ({ json }));"}, "id": "extract", "name": "Extract Validate Deduplicate", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1100, 0]},
    {"parameters": {"operation": "append", "documentId": "GOOGLE_SHEET_ID", "sheetName": "Contacts", "columns": {"mappingMode": "autoMapInputData"}, "options": {}}, "id": "contacts", "name": "Append Contacts", "type": "n8n-nodes-base.googleSheets", "typeVersion": 4, "position": [1320, 0], "credentials": {"googleSheetsOAuth2Api": {"name": "Google Sheets account"}}, "retryOnFail": true, "maxTries": 3, "waitBetweenTries": 2000},
    {"parameters": {"operation": "read", "documentId": "GOOGLE_SHEET_ID", "sheetName": "Contacts", "options": {}}, "id": "eligible-read", "name": "Read Contacts", "type": "n8n-nodes-base.googleSheets", "typeVersion": 4, "position": [1540, 0], "credentials": {"googleSheetsOAuth2Api": {"name": "Google Sheets account"}}},
    {"parameters": {"mode": "runOnceForAllItems", "jsCode": "return $input.all().filter(item => ['New','Sent_1'].includes(item.json.Status) && item.json.Reply_Detected !== 'true' && item.json.Unsubscribe_Detected !== 'true');"}, "id": "eligible", "name": "Keep Eligible Contacts", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1760, 0]},
    {"parameters": {"operation": "send", "sendTo": "={{$json.Contact_Email}}", "subject": "={{$('Read Config').first().json.subject_1}}", "emailType": "text", "message": "={{$('Read Config').first().json.template_1}}", "options": {}}, "id": "email1", "name": "Send Email 1", "type": "n8n-nodes-base.gmail", "typeVersion": 2.1, "position": [1980, 0], "retryOnFail": true, "maxTries": 3, "waitBetweenTries": 4000, "credentials": {"gmailOAuth2": {"name": "Gmail test account"}}},
    {"parameters": {"operation": "append", "documentId": "GOOGLE_SHEET_ID", "sheetName": "Logs", "columns": {"mappingMode": "defineBelow", "value": {"Timestamp": "={{$now}}", "Event": "email_sent", "Contact_Email": "={{$('Keep Eligible Contacts').item.json.Contact_Email}}", "Sequence": 1, "Message_ID": "={{$json.id || $json.messageId || ''}}", "Status": "Sent_1", "Attempts": 1}}, "options": {}}, "id": "log1", "name": "Log Email 1", "type": "n8n-nodes-base.googleSheets", "typeVersion": 4, "position": [2200, 0], "credentials": {"googleSheetsOAuth2Api": {"name": "Google Sheets account"}}, "retryOnFail": true, "maxTries": 3, "waitBetweenTries": 2000},
    {"parameters": {"amount": "={{Number($('Read Config').first().json.delay_hours_1 || 24)}}", "unit": "hours"}, "id": "wait", "name": "Wait Before Email 2", "type": "n8n-nodes-base.wait", "typeVersion": 1.1, "position": [2420, 0]},
    {"parameters": {"operation": "getAll", "returnAll": false, "limit": 20, "filters": {"search": "={{'from:' + $('Keep Eligible Contacts').item.json.Contact_Email}}"}}, "id": "replies", "name": "Check Replies", "type": "n8n-nodes-base.gmail", "typeVersion": 2.1, "position": [2640, 0], "alwaysOutputData": true, "credentials": {"gmailOAuth2": {"name": "Gmail test account"}}},
    {"parameters": {"mode": "runOnceForAllItems", "jsCode": "const words = String($('Read Config').first().json.stop_words || 'unsubscribe,stop,remove').toLowerCase().split(',').map(x => x.trim()).filter(Boolean);\nconst text = JSON.stringify($input.all()).toLowerCase();\nif (words.some(word => text.includes(word)) || text.includes('reply')) return [];\nreturn [{ json: $('Keep Eligible Contacts').item.json }];"}, "id": "stop", "name": "Stop On Reply Or Unsubscribe", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [2860, 0]},
    {"parameters": {"operation": "send", "sendTo": "={{$json.Contact_Email}}", "subject": "={{$('Read Config').first().json.subject_2}}", "emailType": "text", "message": "={{$('Read Config').first().json.template_2}}", "options": {}}, "id": "email2", "name": "Send Email 2", "type": "n8n-nodes-base.gmail", "typeVersion": 2.1, "position": [3080, 0], "retryOnFail": true, "maxTries": 3, "waitBetweenTries": 4000, "credentials": {"gmailOAuth2": {"name": "Gmail test account"}}},
    {"parameters": {"operation": "append", "documentId": "GOOGLE_SHEET_ID", "sheetName": "Logs", "columns": {"mappingMode": "defineBelow", "value": {"Timestamp": "={{$now}}", "Event": "email_sent", "Contact_Email": "={{$json.Contact_Email}}", "Sequence": 2, "Message_ID": "={{$json.id || $json.messageId || ''}}", "Status": "Sent_2", "Attempts": 1}}, "options": {}}, "id": "log2", "name": "Log Email 2", "type": "n8n-nodes-base.googleSheets", "typeVersion": 4, "position": [3300, 0], "credentials": {"googleSheetsOAuth2Api": {"name": "Google Sheets account"}}, "retryOnFail": true, "maxTries": 3, "waitBetweenTries": 2000}
  ],
